{{- /* Overrides the HugoBlox Netlify template, whose whitespace trimming merged "/*" with the first header line,
       so none of these headers were served. Embedding stays allowed (frame_options: allow); HSTS comes from Netlify. */ -}}
{{- $perms := site.Params.hugoblox.security.permissions_policy | default "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" -}}
# Netlify headers (generated by layouts/index.headers)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: {{ $perms }}
/index.webmanifest
  Content-Type: application/manifest+json
/index.xml
  Content-Type: application/rss+xml
